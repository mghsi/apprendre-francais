# Public frontend configuration only. These values are embedded in the
# browser bundle and must never contain secrets.
VITE_API_ORIGIN=
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
# Auth0 database connection name for password reset emails.
VITE_AUTH0_DATABASE_CONNECTION=Username-Password-Authentication

# Backend configuration, including database and LLM credentials, belongs in
# apps/api/.env. See apps/api/.env.example for the supported variable names.
